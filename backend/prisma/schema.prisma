generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  patients  Patient[]
  users     User[]
}

model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  role                  Role                 @default(PROFESSIONAL)
  clinicId              String?
  billingCycle          String               @default("mensal")
  canceledAt            DateTime?
  lastLoginAt           DateTime?
  loginCount            Int                  @default(0)
  createdAt             DateTime             @default(now())
  password              String
  authProvider          String               @default("password")
  avatarUrl             String?
  googleId              String?              @unique
  plan                  String               @default("solo")
  featureOverrides      Json?
  mustChangePassword    Boolean              @default(false)
  cardBrand             String?
  cardLast4             String?
  cardHolderName        String?
  cardExpiry            String?
  gender                String?
  nickname              String?
  clinicName            String?
  specialty             String?
  professionalId        String?
  personType            String?
  phone                 String?
  cpf                   String?
  cnpj                  String?
  rg                    String?
  birthDate             DateTime?
  street                String?
  addressNumber         String?
  complement            String?
  neighborhood          String?
  city                  String?
  state                 String?
  zipCode               String?
  asaasApiKey           String?
  asaasWalletId         String?
  asaasAccountId        String?
  asaasAccountStatus    String?
  asaasSubscriptionId   String? // assinatura recorrente Asaas (mensalidade SaaS)
  subscriptionStatus    String? // trialing | active | past_due | suspended | canceled
  trialEndsAt           DateTime? // fim do trial (1ª cobrança acontece nesta data)
  overdueSince          DateTime? // início do atraso; após GRACE dias sem pagar, acesso bloqueia
  // Ciclo de vida self-service
  demoExpiresAt         DateTime? // conta demo temporária expira nesta data (cron limpa)
  leadSource            String? // "self-service" | "assistido"
  acquisitionChannel    String? // ads | influencer | cupom (UTM/origem)
  lgpdAcceptedAt        DateTime?
  lgpdVersion           String?
  contractAcceptedAt    DateTime?
  contractVersion       String?
  whatsappAccessToken   String?
  whatsappPhoneNumberId String?
  whatsappWabaId        String?
  whatsappBusinessId    String?
  whatsappStatus        String? // null | "connected" | "pending" | "error"
  whatsappConnectedAt   DateTime?
  appointments          Appointment[]
  automationLogs        AutomationLog[]
  whatsappInbounds      WhatsappInbound[]
  automationTemplates   AutomationTemplate[]
  budgets               Budget[]
  clubMembers           ClubMember[]
  clubPlans             ClubPlan[]
  documents             Document[]
  documentFolders       DocumentFolder[]
  evolutions            Evolution[]
  patients              Patient[]
  patientDocuments      PatientDocument[]
  patientPhotos         PatientPhoto[]
  procedures            Procedure[]
  procedureMaps         ProcedureMap[]
  protocols             Protocol[]
  products              Product[]
  productMovements      ProductMovement[]
  stockRequests         StockRequest[]
  transactions          Transaction[]
  documentVersions      DocumentVersion[]
  anamnesisTemplates    AnamnesisTemplate[]
  anamnesisResponses    AnamnesisResponse[]
  cardFees              CardFee[]
  portfolioCases        PortfolioCase[]
  usageCounters         UsageCounter[]
  usageEvents           UsageEvent[]
  iosMemberships        IosMembership[]
  iosPositions          IosPosition[]        @relation("IosPositionOccupant")
  clinic                Clinic?              @relation(fields: [clinicId], references: [id])
}

// Saldo/consumo do ciclo atual por tenant (User) e por recurso medido.
// Uma linha por userId × resource × mês. limit copiado do plano no nascimento da
// linha (mudança de plano no meio do mês não reescreve retroativo). Reset é lazy:
// a linha do próximo mês nasce zerada na 1ª ação do novo período.
model UsageCounter {
  id          String   @id @default(cuid())
  userId      String
  resource    String // "ai" | "whatsapp" | futuros (string livre)
  periodStart DateTime // 1º dia do mês (UTC), âncora do ciclo
  limit       Int? // null = ilimitado (plano dev/enterprise ou recurso sem cota)
  used        Int      @default(0)
  topup       Int      @default(0) // avulso comprado no ciclo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, periodStart])
  @@index([userId, resource])
}

// Log append-only de cada débito — fonte de verdade p/ auditoria, dashboard de
// consumo e conferência de margem/fatura. used do counter é só o agregado rápido.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  resource  String
  cost      Int      @default(1)
  meta      Json? // ex: { fn: "generatePatientSummary", patientId }
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resource, createdAt])
}

model Patient {
  id                 String              @id @default(cuid())
  name               String
  email              String?
  phone              String
  birthDate          DateTime?
  document           String?
  observations       String?
  alertLevel         String?             @default("none")
  aiSummary          String?
  aiSummaryAt        DateTime?
  clinicId           String?
  userId             String
  createdAt          DateTime            @default(now())
  isActive           Boolean             @default(true)
  city               String?
  country            String?
  cpf                String?
  rg                 String?
  state              String?
  street             String?
  zipCode            String?
  appointments       Appointment[]
  automationLogs     AutomationLog[]
  whatsappInbounds   WhatsappInbound[]
  budgets            Budget[]
  clubMemberships    ClubMember[]
  evolutions         Evolution[]
  clinic             Clinic?             @relation(fields: [clinicId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  patientDocuments   PatientDocument[]
  photos             PatientPhoto[]
  procedureMaps      ProcedureMap[]
  transactions       Transaction[]
  anamnesisResponses AnamnesisResponse[]
  portfolioCases     PortfolioCase[]
}

model Budget {
  id             String          @id @default(cuid())
  title          String
  validUntil     DateTime?
  subtotal       Float           @default(0)
  discount       Float           @default(0)
  total          Float           @default(0)
  observations   String?
  status         String          @default("rascunho") // rascunho | aprovado | concluido
  isPackage      Boolean         @default(false) // true = pacote de sessoes (aparece em /sessoes); false = avulso
  sessionCount   Int             @default(1) // nº de sessões do pacote (uma sessão pode ter vários procedimentos)
  idempotencyKey String?         @unique
  patientId      String
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  patient        Patient         @relation(fields: [patientId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  items          BudgetItem[]
  sessions       BudgetSession[]
  transactions   Transaction[]
}

model BudgetItem {
  id            String   @id @default(cuid())
  procedureId   String?
  procedureName String
  quantity      Int      @default(1)
  unitPrice     Float    @default(0)
  total         Float    @default(0)
  observation   String?
  // Agrupa itens em cards de sessão (0-based). null = orçamento antigo/avulso
  // sem detalhamento por sessão (a overview de Sessões segue funcionando igual).
  sessionIndex  Int?
  budgetId      String
  createdAt     DateTime @default(now())
  budget        Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

// Uma sessão realizada de um pacote (orçamento com isPackage=true).
// O pacote tem N sessões (Budget.sessionCount); cada sessão pode conter vários
// procedimentos (campo procedures = snapshot do que foi feito naquele dia).
// appointmentId liga a sessão ao agendamento que a consumiu (opcional).
model BudgetSession {
  id            String       @id @default(cuid())
  budgetId      String
  appointmentId String?
  performedAt   DateTime     @default(now())
  procedures    Json? // [{ procedureId?, procedureName }] feitos nesta sessão
  notes         String?
  createdAt     DateTime     @default(now())
  budget        Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([appointmentId])
}

// Protocolo = template reutilizável de pacote (Lote 6). Montado em /sessoes:
// define N SESSÕES; cada sessão tem seus procedimentos, e cada procedimento
// seus produtos (materiais) e valor. Ao vender, é selecionado dentro do
// Orçamento e o pré-preenche (título + as sessões viram cards de itens). NÃO
// dá baixa de estoque nem cria financeiro por si — é só um molde. A baixa
// acontece via Evolução; o financeiro, ao criar o orçamento.
// Valor: soma dos procedimentos de todas as sessões; se useFixedPrice, fixedPrice.
model Protocol {
  id            String            @id @default(cuid())
  name          String
  description   String?
  useFixedPrice Boolean           @default(false) // true = usa fixedPrice; false = soma dos procedimentos
  fixedPrice    Float? // preço fechado do pacote (quando useFixedPrice)
  isActive      Boolean           @default(true)
  userId        String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id])
  sessions      ProtocolSession[]

  @@index([userId])
}

// Uma sessão do protocolo (card). O nº de sessões do pacote = nº de
// ProtocolSession. Cada sessão agrupa os procedimentos previstos para aquele dia.
model ProtocolSession {
  id         String              @id @default(cuid())
  protocolId String
  position   Int                 @default(0) // ordem/índice da sessão (0-based)
  label      String? // rótulo opcional (ex.: "Sessão de manutenção")
  createdAt  DateTime            @default(now())
  protocol   Protocol            @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  procedures ProtocolProcedure[]

  @@index([protocolId])
}

// Um procedimento dentro de uma sessão do protocolo (snapshot nome + preço editável).
model ProtocolProcedure {
  id            String            @id @default(cuid())
  sessionId     String
  procedureId   String? // referência ao catálogo (nullable p/ histórico)
  procedureName String // snapshot do nome
  unitPrice     Float             @default(0) // preço puxado do procedimento, editável
  quantity      Int               @default(1)
  position      Int               @default(0) // ordem de exibição dentro da sessão
  createdAt     DateTime          @default(now())
  session       ProtocolSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  products      ProtocolProduct[]

  @@index([sessionId])
}

// Um produto/material planejado para um procedimento do protocolo. Serve de
// referência/estimativa (o clínico ajusta o gasto real na Evolução, que é onde
// a baixa de estoque efetivamente ocorre).
model ProtocolProduct {
  id                  String            @id @default(cuid())
  protocolProcedureId String
  productId           String? // nullable: material avulso/custom
  customName          String? // nome livre quando não é produto do catálogo
  quantity            Float             @default(1)
  createdAt           DateTime          @default(now())
  protocolProcedure   ProtocolProcedure @relation(fields: [protocolProcedureId], references: [id], onDelete: Cascade)

  @@index([protocolProcedureId])
}

model Appointment {
  id                  String                 @id @default(cuid())
  title               String
  description         String?
  startsAt            DateTime
  endsAt              DateTime
  patientId           String?
  userId              String
  createdAt           DateTime               @default(now())
  color               String?
  notes               String?
  procedureType       String?
  professional        String?
  status              String                 @default("SCHEDULED")
  idempotencyKey      String?                @unique
  // consulta | retorno | lembrete | compromisso | bloqueio | receivable | payable
  // SÓ consulta e retorno geram mensagem ao paciente — as demais são anotações
  // internas da agenda. A regra vive em CATEGORIAS_COM_PACIENTE
  // (automation.service.js) como allowlist: categoria nova nasce muda.
  category            String                 @default("consulta")
  isAllDay            Boolean                @default(false)
  recurrenceRule      String? // RRULE (ex: FREQ=WEEKLY;INTERVAL=1) p/ compromissos recorrentes
  parentAppointmentId String? // liga o retorno ao agendamento de origem
  // Vínculo opcional com um pacote de sessões (item 6/7). Ao concluir o
  // agendamento, consome 1 sessão do pacote correspondente.
  packageOrigin       String? // "club" | "budget"
  packageItemId       String? // planItemId (club) ou budgetId (budget)
  packageMemberId     String? // memberId (só club)
  patient             Patient?               @relation(fields: [patientId], references: [id])
  user                User                   @relation(fields: [userId], references: [id])
  transaction         Transaction?
  procedures          AppointmentProcedure[]
  budgetSessions      BudgetSession[]
  clubApplications    ClubApplication[]
  procedureMaps       ProcedureMap[]
}

// Um procedimento dentro de um agendamento (permite vários por atendimento).
// Espelha o padrão de BudgetItem. procedureType (string) em Appointment segue
// preenchido com o 1º procedimento p/ compatibilidade com dados/código antigos.
model AppointmentProcedure {
  id            String      @id @default(cuid())
  appointmentId String
  procedureId   String? // nullable: procedimento pode ter sido removido do catálogo
  procedureName String // snapshot do nome (compat + histórico)
  quantity      Int         @default(1)
  unitPrice     Float       @default(0)
  total         Float       @default(0)
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model Evolution {
  id                String     @id @default(cuid())
  name              String? // título/nome da evolução (ex.: "Sessão de limpeza de pele")
  content           String?
  photoUrl          String?
  patientId         String
  createdById       String
  createdAt         DateTime   @default(now())
  date              DateTime?
  materialsUsed     Json?
  procedureId       String?
  description       String?
  materials         String?
  procedure         String?
  createdBy         User       @relation(fields: [createdById], references: [id])
  patient           Patient    @relation(fields: [patientId], references: [id])
  procedureRelation Procedure? @relation("ProcedureToEvolution", fields: [procedureId], references: [id])
}

model Procedure {
  id                  String             @id @default(cuid())
  name                String
  description         String?
  isActive            Boolean            @default(true)
  userId              String
  createdAt           DateTime           @default(now())
  category            String?
  duration            Int?
  hasMultipleSessions Boolean            @default(false)
  price               Float?
  requiresReturn      Boolean            @default(false)
  returnDays          Int?
  isDefault           Boolean            @default(false) // veio do catálogo padrão (não criado pelo usuário)
  evolutions          Evolution[]        @relation("ProcedureToEvolution")
  user                User               @relation(fields: [userId], references: [id])
  products            ProcedureProduct[]
}

model ProcedureProduct {
  id          String    @id @default(cuid())
  procedureId String
  productId   String?
  customName  String?
  quantity    Float?
  perSession  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  procedure   Procedure @relation(fields: [procedureId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  description       String?
  category          String? // ex: descartaveis | insumos (texto livre)
  supplier          String? // fornecedor (ex: Mercado Livre, Galderma)
  unitPrice         Float? // preço unitário de compra (R$)
  stock             Float?             @default(0)
  unit              String?
  userId            String
  createdAt         DateTime           @default(now())
  minStock          Float?
  lotNumber         String?
  expiryDate        DateTime?
  procedureProducts ProcedureProduct[]
  user              User               @relation(fields: [userId], references: [id])
  movements         ProductMovement[]
  stockRequests     StockRequest[]
}

model StockRequest {
  id         String    @id @default(cuid())
  type       String
  quantity   Float
  reason     String?
  status     String    @default("pending")
  resolvedAt DateTime?
  productId  String
  userId     String
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}

model ProductMovement {
  id        String   @id @default(cuid())
  type      String
  quantity  Float
  reason    String?
  productId String
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model ProcedureMap {
  id                String         @id @default(cuid())
  title             String?
  date              DateTime       @default(now())
  markers           Json           @default("[]")
  products          Json           @default("[]") // [{id, productId?, productName, lotNumber?, expiryDate?, dilutionDate?, dilutionVolume?, vialQuantity?, vialUnit?}] — marker.productId aponta p/ um destes
  patientId         String
  userId            String
  createdAt         DateTime       @default(now())
  backgroundPhotoId String?
  baseImage         String?
  applicationDate   DateTime?
  clinicalNotes     String?
  dilutionDate      DateTime?
  dilutionVolume    Float?
  expiryDate        DateTime?
  lotNumber         String?
  productName       String?
  vialPresentation  String?
  vialQuantity      String?
  vialUnit          String?
  // Vínculo opcional com o agendamento que originou este mapa (item 11).
  appointmentId     String?
  // Mapa de origem quando este é um "retorno" que replica pontos p/ sobrepontos.
  parentMapId       String?
  patient           Patient        @relation(fields: [patientId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  appointment       Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  parentMap         ProcedureMap?  @relation("MapRetornos", fields: [parentMapId], references: [id], onDelete: SetNull)
  retornos          ProcedureMap[] @relation("MapRetornos")

  @@index([appointmentId])
  @@index([parentMapId])
}

model ClubPlan {
  id           String         @id @default(cuid())
  name         String
  description  String?
  price        Float          @default(0)
  billingCycle String         @default("mensal")
  isActive     Boolean        @default(true)
  userId       String
  createdAt    DateTime       @default(now())
  members      ClubMember[]
  user         User           @relation(fields: [userId], references: [id])
  items        ClubPlanItem[]
}

model ClubPlanItem {
  id             String            @id @default(cuid())
  planId         String
  procedureName  String
  quantity       Int               @default(1)
  intervalMonths Int               @default(12)
  createdAt      DateTime          @default(now())
  applications   ClubApplication[]
  plan           ClubPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model ClubMember {
  id            String            @id @default(cuid())
  patientId     String
  planId        String
  startDate     DateTime
  endDate       DateTime?
  status        String            @default("ativo")
  paymentMethod String?
  notes         String?
  userId        String
  createdAt     DateTime          @default(now())
  applications  ClubApplication[]
  patient       Patient           @relation(fields: [patientId], references: [id])
  plan          ClubPlan          @relation(fields: [planId], references: [id])
  user          User              @relation(fields: [userId], references: [id])
}

model ClubApplication {
  id            String       @id @default(cuid())
  memberId      String
  planItemId    String
  appointmentId String?
  appliedAt     DateTime
  nextDueAt     DateTime
  notes         String?
  createdAt     DateTime     @default(now())
  member        ClubMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planItem      ClubPlanItem @relation(fields: [planItemId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

model Transaction {
  id                 String       @id @default(cuid())
  type               String
  status             String       @default("pendente")
  description        String
  amount             Float        @default(0)
  paymentMethod      String?
  dueDate            DateTime?
  paidAt             DateTime?
  appointmentId      String?      @unique
  patientId          String?
  userId             String
  createdAt          DateTime     @default(now())
  category           String?
  isRecurring        Boolean      @default(false)
  recurringDay       Int?
  budgetId           String?
  installmentGroupId String?
  installmentNumber  Int?
  installments       Int?
  notes              String?
  cardBrand          String? // bandeira usada, quando pagamento no cartão
  feePercent         Float? // % de taxa da maquininha aplicada
  feeAmount          Float? // custo da taxa em R$ (amount * feePercent)
  netAmount          Float? // valor líquido recebido (amount - feeAmount)
  settlementType     String? // imediato | crediario — compensação do recebimento no cartão
  // Id da cobrança no Asaas (pay_xxx), preenchido quando a Transaction vira
  // cobrança de verdade. Antes disso o vínculo existia só do lado de lá
  // (externalReference aponta para cá), então não dava para saber, olhando a
  // Transaction, se já havia cobrança — nem para evitar gerar duas.
  asaasChargeId      String?      @unique
  // Falha ao gerar a cobrança no Asaas. A geração é não-bloqueante (não pode
  // derrubar o agendamento), então o erro precisa ficar visível em algum lugar
  // — senão a clínica acha que cobrou e não cobrou. Fica na própria Transaction
  // porque é o registro que a pessoa reabre no Faturamento para tentar de novo.
  chargeError        String? // mensagem do Asaas (ex.: "CPF do cliente inválido")
  chargeErrorAt      DateTime?
  // Split de pagamento (Asaas): comissão IASOPay retida na cobrança clínica→paciente.
  splitApplied       Boolean      @default(false) // true se a cobrança saiu com split
  splitType          String? // PERCENTAGE | FIXED — tipo enviado ao Asaas
  splitValue         Float? // valor/percentual configurado no momento da cobrança
  iasoRevenue        Float? // R$ estimado da comissão IASOPay nesta cobrança
  appointment        Appointment? @relation(fields: [appointmentId], references: [id])
  budget             Budget?      @relation(fields: [budgetId], references: [id])
  patient            Patient?     @relation(fields: [patientId], references: [id])
  user               User         @relation(fields: [userId], references: [id])
}

model PatientPhoto {
  id        String   @id @default(cuid())
  fileName  String
  filePath  String
  fileSize  Int?
  mimeType  String?
  category  String? // null = foto comum; "device" = foto do dispositivo/aparelho usado
  patientId String
  userId    String
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// Case salvo do portfólio (vitrine interna de antes/depois).
// Guarda o par de fotos (referência a PatientPhoto) + metadados do case.
model PortfolioCase {
  id            String   @id @default(cuid())
  title         String?
  procedureName String?
  caption       String? // legenda/descrição do resultado
  featured      Boolean  @default(false)
  beforePhotoId String
  afterPhotoId  String
  devicePhotoId String? // foto do dispositivo/aparelho usado (PatientPhoto, opcional)
  patientId     String
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  patient       Patient  @relation(fields: [patientId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Document {
  id               String            @id @default(cuid())
  name             String
  type             String            @default("termo")
  fileName         String
  filePath         String
  fileSize         Int?
  fields           Json?
  userId           String
  folderId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  folder           DocumentFolder?   @relation(fields: [folderId], references: [id])
  patientDocuments PatientDocument[]
  versions         DocumentVersion[]

  @@index([folderId])
}

model DocumentFolder {
  id        String     @id @default(cuid())
  name      String
  isDefault Boolean    @default(false) // pastas fixas seedadas (Sanitária, Documentos para assinatura)
  userId    String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  documents Document[]

  @@unique([userId, name])
  @@index([userId])
}

model PatientDocument {
  id                    String    @id @default(cuid())
  status                String    @default("pending")
  signedAt              DateTime?
  fieldValues           Json?
  professionalSignature String?
  patientSignature      String?
  documentId            String
  patientId             String
  userId                String
  createdAt             DateTime  @default(now())
  auditTrail            Json?
  originalHash          String?
  signedFilePath        String?
  signedFileSize        Int?
  signedHash            String?
  signerCpf             String?
  signerIp              String?
  signerName            String?
  signerUserAgent       String?
  signerEmail           String?
  signerPhone           String?
  signerTimezone        String?
  acceptedTerms         Boolean   @default(false)
  acceptedAt            DateTime?
  otpMethod             String?
  otpValidatedAt        DateTime?
  latitude              Float?
  longitude             Float?
  geolocationConsent    Boolean   @default(false)
  document              Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  patient               Patient   @relation(fields: [patientId], references: [id])
  user                  User      @relation(fields: [userId], references: [id])
}

model OtpCode {
  id        String    @id @default(cuid())
  context   String
  method    String
  target    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  hash       String
  fileUrl    String
  createdBy  String
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [createdBy], references: [id])
}

model AutomationTemplate {
  id                  String          @id @default(cuid())
  type                String
  name                String
  body                String
  isActive            Boolean         @default(true)
  reminderHoursBefore Int?
  metaTemplateName    String?
  metaLanguage        String?         @default("pt_BR")
  metaVariables       String[]        @default([])
  userId              String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  logs                AutomationLog[]
  user                User            @relation(fields: [userId], references: [id])
}

model AutomationLog {
  id            String              @id @default(cuid())
  type          String
  patientName   String
  phone         String
  message       String
  status        String              @default("pending")
  scheduledFor  DateTime
  sentAt        DateTime?
  error         String?
  templateId    String?
  patientId     String?
  userId        String
  metaMessageId String? // ID retornado pela Meta; casa com status do webhook
  createdAt     DateTime            @default(now())
  patient       Patient?            @relation(fields: [patientId], references: [id])
  template      AutomationTemplate? @relation(fields: [templateId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
}

// Respostas dos pacientes recebidas via webhook do WhatsApp.
// Como o número é compartilhado, cada inbound é atribuído à clínica (userId)
// pelo envio mais recente àquele telefone (ver whatsappWebhook.js).
model WhatsappInbound {
  id            String    @id @default(cuid())
  userId        String // clínica atribuída
  phone         String // telefone do paciente (from)
  patientId     String?
  patientName   String?
  text          String? // texto livre, se houver
  buttonPayload String? // texto do botão clicado (ex.: "Confirmar presença")
  kind          String    @default("text") // text | button | interactive
  metaMessageId String? // id da mensagem recebida (idempotência)
  appointmentId String? // agendamento afetado, se a resposta agiu na agenda
  handled       String? // "confirmed" | "reschedule" | null (o que a resposta disparou)
  createdAt     DateTime  @default(now())
  patient       Patient?  @relation(fields: [patientId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([metaMessageId])
}

model AdminTask {
  id                 String                  @id @default(cuid())
  number             Int                     @unique @default(autoincrement())
  title              String
  description        String?
  priority           String                  @default("media")
  status             String                  @default("backlog")
  area               String?
  clinicId           String?
  dueDate            DateTime?
  reminderAt         DateTime?
  assignees          Json?
  attachments        Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  comments           AdminTaskComment[]
  iosInitiativeLinks IosInitiativeTaskLink[]
  iosReleaseLinks    IosProductReleaseTask[]
}

model AdminTaskComment {
  id        String    @id @default(cuid())
  taskId    String
  content   String
  author    String
  type      String    @default("comment")
  createdAt DateTime  @default(now())
  task      AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Lead {
  id             String             @id @default(cuid())
  name           String
  email          String?
  phone          String?
  clinicName     String?
  source         String?
  status         String             @default("prospecto")
  value          Float?
  notes          String?
  nextFollowUp   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  stageHistory   LeadStageHistory[]
  iosCommissions IosCommission[]
}

model LeadStageHistory {
  id        String   @id @default(cuid())
  leadId    String
  fromStage String?
  toStage   String
  changedBy String?
  source    String   @default("admin")
  changedAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, changedAt])
  @@index([toStage, changedAt])
}

model AdminFinancialEntry {
  id               String    @id @default(cuid())
  type             String
  description      String
  amount           Float
  category         String?
  status           String    @default("pendente")
  clinicId         String?
  clinicName       String?
  planType         String?
  paymentMethod    String?
  dueDate          DateTime?
  paidAt           DateTime?
  notes            String?
  recorrente       Boolean   @default(false)
  recorrencia      String?
  recorrenciaFim   DateTime?
  recorrenciaRef   String?
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?
  societySettled   Boolean   @default(false) // despesa já acertada entre os sócios
  societySettledAt DateTime?
  societyPaid      Json? // { [socioKey]: valor já coberto por cada sócio }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String // id do admin que executou
  actorName  String?
  action     String // ex: "clinic.delete", "clinic.plan", "clinic.features"
  targetType String? // ex: "clinic"
  targetId   String?
  targetName String?
  detail     Json? // dados extras (plano antigo/novo, etc.)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model AdminNotification {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  taskTitle String?
  content   String
  author    String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CsNote {
  id        String   @id @default(cuid())
  clinicId  String
  content   String
  type      String   @default("geral")
  createdAt DateTime @default(now())
}

// Estimativas salvas do Planejamento Financeiro (snapshot completo das premissas)
model FinancialEstimate {
  id        String   @id @default(cuid())
  title     String
  author    String
  premissas Json
  createdAt DateTime @default(now())
}

// Configurações globais do admin (key-value). Ex.: premissas oficiais do
// Planejamento Financeiro, compartilhadas entre todos os sócios.
model AdminSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// IASO Operating System (IOS)
// Dados internos da empresa. O core continua sendo a fonte de verdade; o app
// admin apenas consome estas entidades pelo gateway.

model IosOrganization {
  id                 String                       @id @default(cuid())
  name               String
  slug               String                       @unique
  mission            String?
  vision             String?
  values             Json?
  timezone           String                       @default("America/Sao_Paulo")
  currency           String                       @default("BRL")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  memberships        IosMembership[]
  cycles             IosStrategyCycle[]
  metrics            IosMetricDefinition[]
  decisions          IosDecision[]
  auditLogs          IosAuditLog[]
  businessEvents     IosBusinessEvent[]
  scenarios          IosScenario[]
  commercialChannels IosCommercialChannel[]
  campaigns          IosCampaign[]
  partners           IosPartner[]
  commissions        IosCommission[]
  productReleases    IosProductRelease[]
  adoptionSnapshots  IosProductAdoptionSnapshot[]
  positions          IosPosition[]
}

model IosMembership {
  id               String                @id @default(cuid())
  organizationId   String
  userId           String
  role             IosMembershipRole     @default(VIEWER)
  capabilities     Json?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     IosOrganization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedCycles      IosStrategyCycle[]    @relation("IosCycleOwner")
  ownedMetrics     IosMetricDefinition[] @relation("IosMetricOwner")
  ownedObjectives  IosObjective[]        @relation("IosObjectiveOwner")
  ownedKeyResults  IosKeyResult[]        @relation("IosKeyResultOwner")
  ownedInitiatives IosInitiative[]       @relation("IosInitiativeOwner")

  @@unique([organizationId, userId])
  @@index([userId])
}

model IosStrategyCycle {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  description    String?
  cadence        IosCycleCadence @default(QUARTERLY)
  startDate      DateTime
  endDate        DateTime
  status         IosCycleStatus  @default(DRAFT)
  ownerId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   IosOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          IosMembership?  @relation("IosCycleOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  objectives     IosObjective[]
  initiatives    IosInitiative[]
  decisions      IosDecision[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([startDate, endDate])
}

model IosMetricDefinition {
  id               String                 @id @default(cuid())
  organizationId   String
  code             String
  name             String
  description      String
  unit             IosMetricUnit
  direction        IosMetricDirection     @default(INCREASE)
  frequency        IosMetricFrequency     @default(MONTHLY)
  sourceType       IosMetricSourceType
  sourceRef        String
  formulaKey       String?
  formulaVersion   String?
  allowManualInput Boolean                @default(false)
  ownerId          String?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     IosOrganization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            IosMembership?         @relation("IosMetricOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  observations     IosMetricObservation[]
  keyResults       IosKeyResult[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model IosMetricObservation {
  id             String              @id @default(cuid())
  metricId       String
  periodStart    DateTime
  periodEnd      DateTime
  value          Decimal             @db.Decimal(20, 6)
  sourceType     IosMetricSourceType
  sourceRef      String
  formulaVersion String?
  inputs         Json?
  note           String?
  measuredAt     DateTime            @default(now())
  createdBy      String
  createdAt      DateTime            @default(now())
  metric         IosMetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([metricId, periodEnd])
  @@index([measuredAt])
}

model IosObjective {
  id          String             @id @default(cuid())
  cycleId     String
  title       String
  description String?
  status      IosObjectiveStatus @default(DRAFT)
  ownerId     String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  cycle       IosStrategyCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  owner       IosMembership?     @relation("IosObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  keyResults  IosKeyResult[]
  initiatives IosInitiative[]
  decisions   IosDecision[]

  @@index([cycleId, status])
}

model IosKeyResult {
  id          String              @id @default(cuid())
  objectiveId String
  metricId    String
  title       String
  baseline    Decimal             @db.Decimal(20, 6)
  target      Decimal             @db.Decimal(20, 6)
  startDate   DateTime
  dueDate     DateTime
  status      IosKeyResultStatus  @default(DRAFT)
  ownerId     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  objective   IosObjective        @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  metric      IosMetricDefinition @relation(fields: [metricId], references: [id], onDelete: Restrict)
  owner       IosMembership?      @relation("IosKeyResultOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([objectiveId, status])
  @@index([metricId])
}

model IosInitiative {
  id          String                  @id @default(cuid())
  cycleId     String
  objectiveId String?
  title       String
  description String?
  status      IosInitiativeStatus     @default(PLANNED)
  priority    IosPriority             @default(MEDIUM)
  ownerId     String?
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  cycle       IosStrategyCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  objective   IosObjective?           @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  owner       IosMembership?          @relation("IosInitiativeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  milestones  IosMilestone[]
  taskLinks   IosInitiativeTaskLink[]

  @@index([cycleId, status])
  @@index([objectiveId])
}

model IosMilestone {
  id           String             @id @default(cuid())
  initiativeId String
  title        String
  status       IosMilestoneStatus @default(PENDING)
  dueDate      DateTime?
  completedAt  DateTime?
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  initiative   IosInitiative      @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@index([initiativeId, status])
}

model IosInitiativeTaskLink {
  initiativeId String
  taskId       String
  linkedBy     String
  linkedAt     DateTime      @default(now())
  initiative   IosInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  task         AdminTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([initiativeId, taskId])
  @@index([taskId])
}

model IosDecision {
  id             String            @id @default(cuid())
  organizationId String
  cycleId        String?
  objectiveId    String?
  title          String
  context        String
  decision       String
  rationale      String?
  alternatives   Json?
  evidence       Json?
  status         IosDecisionStatus @default(DRAFT)
  reviewAt       DateTime?
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   IosOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle          IosStrategyCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  objective      IosObjective?     @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([cycleId])
}

model IosAuditLog {
  id             String          @id @default(cuid())
  organizationId String
  actorUserId    String
  actorName      String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime        @default(now())
  organization   IosOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

model IosBusinessEvent {
  id             String             @id @default(cuid())
  organizationId String
  eventType      String
  occurredAt     DateTime
  sourceType     IosEventSourceType @default(INTERNAL)
  sourceRef      String
  idempotencyKey String
  subjectType    String?
  subjectId      String?
  amount         Decimal?           @db.Decimal(20, 6)
  currency       String?            @default("BRL")
  payload        Json?
  createdBy      String
  createdAt      DateTime           @default(now())
  organization   IosOrganization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, eventType, occurredAt])
  @@index([subjectType, subjectId])
}

model IosScenario {
  id             String                  @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         IosScenarioStatus       @default(DRAFT)
  version        Int                     @default(1)
  horizonStart   DateTime
  horizonEnd     DateTime
  basedOnId      String?
  createdBy      String
  publishedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   IosOrganization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  basedOn        IosScenario?            @relation("IosScenarioVersion", fields: [basedOnId], references: [id], onDelete: SetNull)
  versions       IosScenario[]           @relation("IosScenarioVersion")
  assumptions    IosScenarioAssumption[]
  runs           IosProjectionRun[]

  @@unique([organizationId, name, version])
  @@index([organizationId, status])
}

model IosScenarioAssumption {
  id            String      @id @default(cuid())
  scenarioId    String
  key           String
  label         String
  value         Decimal?    @db.Decimal(20, 6)
  textValue     String?
  unit          String
  justification String?
  sourceRef     String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  scenario      IosScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, key])
  @@index([scenarioId, sortOrder])
}

model IosProjectionRun {
  id           String                 @id @default(cuid())
  scenarioId   String
  modelKey     String
  modelVersion String
  status       IosProjectionRunStatus @default(SUCCEEDED)
  inputs       Json
  outputs      Json
  createdBy    String
  executedAt   DateTime               @default(now())
  scenario     IosScenario            @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, executedAt])
}

model IosCommercialChannel {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  category       String?
  status         IosRecordStatus @default(ACTIVE)
  monthlyBudget  Decimal?        @db.Decimal(20, 2)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   IosOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns      IosCampaign[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model IosCampaign {
  id             String                @id @default(cuid())
  organizationId String
  channelId      String?
  name           String
  objective      String?
  status         IosCampaignStatus     @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  budget         Decimal?              @db.Decimal(20, 2)
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   IosOrganization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        IosCommercialChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([channelId])
}

model IosPartner {
  id              String           @id @default(cuid())
  organizationId  String
  name            String
  status          IosPartnerStatus @default(PROSPECT)
  contactName     String?
  contactEmail    String?
  commissionType  String?
  commissionValue Decimal?         @db.Decimal(20, 6)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    IosOrganization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commissions     IosCommission[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model IosCommission {
  id             String              @id @default(cuid())
  organizationId String
  partnerId      String?
  leadId         String?
  description    String
  amount         Decimal             @db.Decimal(20, 2)
  status         IosCommissionStatus @default(PENDING)
  dueDate        DateTime?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   IosOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner        IosPartner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  lead           Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([partnerId])
  @@index([leadId])
}

model IosProductRelease {
  id             String                  @id @default(cuid())
  organizationId String
  name           String
  version        String?
  description    String?
  status         IosProductReleaseStatus @default(PLANNED)
  plannedAt      DateTime?
  releasedAt     DateTime?
  createdBy      String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   IosOrganization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskLinks      IosProductReleaseTask[]

  @@index([organizationId, status])
  @@index([plannedAt])
}

model IosProductReleaseTask {
  releaseId String
  taskId    String
  linkedBy  String
  linkedAt  DateTime          @default(now())
  release   IosProductRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  task      AdminTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([releaseId, taskId])
  @@index([taskId])
}

model IosProductAdoptionSnapshot {
  id             String          @id @default(cuid())
  organizationId String
  featureKey     String
  featureName    String
  periodStart    DateTime
  periodEnd      DateTime
  eligibleUsers  Int
  activeUsers    Int
  usageCount     Int             @default(0)
  sourceRef      String
  notes          String?
  createdBy      String
  measuredAt     DateTime        @default(now())
  organization   IosOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureKey, periodStart, periodEnd])
  @@index([organizationId, periodEnd])
}

model IosPosition {
  id              String            @id @default(cuid())
  organizationId  String
  title           String
  area            String
  type            IosPositionType   @default(CURRENT)
  status          IosPositionStatus @default(OPEN)
  occupantUserId  String?
  capacityPercent Int               @default(100)
  monthlyCost     Decimal?          @db.Decimal(20, 2)
  targetDate      DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    IosOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  occupant        User?             @relation("IosPositionOccupant", fields: [occupantUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, area])
  @@index([organizationId, status])
  @@index([occupantUserId])
}

enum IosMembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum IosCycleCadence {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum IosCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum IosMetricUnit {
  NUMBER
  BRL
  PERCENTAGE
  DAYS
  MONTHS
  SCORE
}

enum IosMetricDirection {
  INCREASE
  DECREASE
  MAINTAIN
}

enum IosMetricFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  ON_DEMAND
}

enum IosMetricSourceType {
  MANUAL
  CALCULATED
  IMPORTED
  EXTERNAL
}

enum IosObjectiveStatus {
  DRAFT
  ACTIVE
  AT_RISK
  COMPLETED
  CANCELED
}

enum IosKeyResultStatus {
  DRAFT
  ACTIVE
  AT_RISK
  ACHIEVED
