// Modelo de anamnese da clínica (várias por clínica). As perguntas ficam em JSON:
// [{ id, label, type: "text"|"boolean"|"choice", options?: string[], required?: bool }]
model AnamnesisTemplate {
  id        String              @id @default(cuid())
  name      String
  questions Json
  userId    String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id])
  responses AnamnesisResponse[]
}

// Anamnese preenchida de um paciente. answers em JSON: { [questionId]: valor }
model AnamnesisResponse {
  id           String            @id @default(cuid())
  templateId   String
  patientId    String
  userId       String
  answers      Json
  status       String            @default("draft") // draft | finalized
  documentPath String? // PDF gerado no S3 ao finalizar
  finalizedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  template     AnamnesisTemplate @relation(fields: [templateId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
}

// Taxa da maquininha de cartão, por bandeira e tipo/faixa de parcelas.
// type: debito | credito | credito_parcelado
// Para credito_parcelado, a faixa installmentsFrom..installmentsTo define
// a que número de parcelas o percentual se aplica.
model CardFee {
  id               String   @id @default(cuid())
  userId           String
  machineName      String? // apelido da maquininha (clínicas com mais de uma)
  brand            String   @default("Geral") // Visa | Master | Elo | Amex | Hipercard | Geral
  type             String // debito | credito | credito_parcelado
  installmentsFrom Int? // início da faixa (só credito_parcelado)
  installmentsTo   Int? // fim da faixa (só credito_parcelado)
  percent          Float // % descontado pela maquininha
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Configuração do Split de Pagamentos por método (parametrizada no banco, sem
// hardcode). Uma linha por paymentMethod. A aplicação decide entre percentualValue
// (PERCENTAGE) e fixedValue (FIXED) na hora de montar o payload do Asaas.
// paymentMethod: pix | credit_card | boleto   (mesmos labels internos do createCharge)
// splitType:     PERCENTAGE | FIXED
model SplitConfig {
  id            String   @id @default(cuid())
  paymentMethod String   @unique // pix | credit_card | boleto
  splitType     String // PERCENTAGE | FIXED
  splitValue    Float // 0.20 (=0,20% se PERCENTAGE, =R$0,20 se FIXED)
  active        Boolean  @default(true) // false ⇒ não aplica split neste método
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// Custo de WhatsApp cobrado pela Meta, espelhado dia a dia da Graph API
// (/{WABA_ID}/pricing_analytics). Cache local porque a tela do admin não pode
// depender da Graph: rate limit baixo e latência alta. O cron reescreve os
// últimos dias a cada rodada — a Meta revisa números por ~2 dias, então a
// linha só estabiliza depois disso (por isso upsert, nunca create puro).
//
// Granularidade: 1 linha por (dia × categoria × tipo de preço). Não há userId:
// a Meta cobra a WABA inteira e NÃO sabe de qual clínica foi a mensagem — o
// número é único/compartilhado. O rateio por clínica é inferido do
// AutomationLog no serviço, e é estimativa, não medição.
model WhatsappCostDaily {
  id        String   @id @default(cuid())
  day       DateTime // dia UTC (00:00), chave temporal
  category  String // "MARKETING" | "UTILITY" | "AUTHENTICATION" | "SERVICE" | …
  pricing   String // "PAID" | "FREE_TIER" | "FREE_ENTRY_POINT"
  volume    Int      @default(0) // mensagens entregues nesse recorte
  costUsd   Float    @default(0) // custo em USD cobrado pela Meta
  wabaId    String? // qual WABA — preparado p/ multi-WABA
  syncedAt  DateTime @default(now()) // quando o cron gravou esta versão
  createdAt DateTime @default(now())

  @@unique([day, category, pricing, wabaId])
  @@index([day])
}
