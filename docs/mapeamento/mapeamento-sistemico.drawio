        <mxCell id="n13" value="logAndSend()
-&gt; AutomationLog + Meta" style="rounded=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="160" width="210" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="RISCO ALTO: jobs rodam DENTRO do processo Express.
Com 2+ instancias (PM2 cluster ou autoscaling),
OS CRONS DUPLICAM os envios. Nao ha lock distribuido." style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;strokeColor=#b85450;strokeWidth=3;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="620" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="RISCO: restart do servidor durante o processamento
deixa eventos travados em 'processing' para sempre
(nao ha reaper de claim expirado identificado)." style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;strokeColor=#b85450;strokeWidth=3;dashed=1;" vertex="1" parent="1">
