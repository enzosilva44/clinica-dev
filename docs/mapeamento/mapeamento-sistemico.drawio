        </mxCell>
        <mxCell id="n30" value="NAO IDENTIFICADO NO CODIGO: job de reconciliacao financeira (comparar Asaas x Transaction), job de limpeza de OtpCode expirado, job de backup logico, rotina de reprocessamento de WebhookEvent 'failed', e monitoramento de execucao dos crons (se um cron parar, ninguem sabe)." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
