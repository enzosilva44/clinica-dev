        <mxCell id="n44" value="PONTA SOLTA (ALTA): as rotas /admin/* sao montadas SEM authorize(['ADMIN']). A protecao depende de checagem interna em cada handler (req.user.role === 'ADMIN'). Qualquer rota nova que esqueca essa checagem fica exposta a qualquer usuario autenticado. VERIFICACAO HUMANA NECESSARIA rota a rota." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="760" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="PONTA SOLTA (MEDIA): AdminAuditLog existe, mas so cobre acoes do painel admin. Acoes destrutivas da CLINICA (excluir paciente, excluir lancamento financeiro, excluir agendamento) NAO geram trilha de auditoria." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
