        <mxCell id="n53" value="REGRA CONFIRMADA: a 'assinatura digital' e um aceite com OTP (codigo enviado ao paciente) gravado em PatientDocument. NAO ha certificado digital ICP-Brasil, carimbo de tempo, nem hash do documento assinado no codigo lido. Valor juridico exige VALIDACAO HUMANA/JURIDICA." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="720" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="PONTA SOLTA: uploads vao para disco local (uploads/ servido por express.static). Existe script migrate-uploads-to-s3.js, mas o app.js ainda serve do disco - em EC2 com redeploy, arquivos podem se perder. INTEGRACAO S3 PENDENTE OU PARCIAL." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="810" y="720" width="720" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="LEGENDA" style="swimlane;startSize=26;html=1;fontSize=11;fontStyle=1;fillColor=#fbfbfb;strokeColor=#b3b3b3;" vertex="1" parent="1">
