  <diagram id="16_-_Processos_Automaticos,_Filas_e_Jobs" name="16 - Processos Automaticos, Filas e Jobs">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="Jobs e filas - tudo IN-PROCESS no mesmo servidor Express" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="server.js chama startAutomationCrons() e startWebhookWorker(). Sem Redis, sem BullMQ, sem SQS. O Postgres e a fila." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="server.js  app.listen()" style="rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="270" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="CRON 0 9 * * *
runBirthdayCron()
aniversariantes do dia" style="rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="230" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="CRON */30 * * * *
runReminderCron()
lembretes de consulta" style="rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="204" width="230" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="CRON 15 * * * *
cleanupExpiredDemos()
demos com TTL 48h" style="rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="288" width="230" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="webhookWorker
loop continuo, BATCH=20" style="rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="372" width="230" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="Le WebhookEvent
status='pending' e elegivel
pelo backoff" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="372" width="210" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="Marca 'processing'
(claim atomico)" style="rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="372" width="210" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="Sucesso -&gt; 'processed'" style="rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="340" width="210" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="Erro -&gt; attempts+1, volta a 'pending'
backoff 0/1/5/15/60 min" style="rounded=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="394" width="210" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="attempts &gt;= 5 -&gt; 'failed'
SEM ALERTA, SEM TELA
DE REPROCESSAMENTO" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;strokeColor=#b85450;strokeWidth=3;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="460" width="210" height="62" as="geometry"/>
