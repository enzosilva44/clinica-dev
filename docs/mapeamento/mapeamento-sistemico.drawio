        <mxCell id="n73" value="NAO IDENTIFICADOS NO CODIGO: SMS, push notification, e-mail transacional de marketing, central de preferencias de comunicacao do paciente, opt-out / descadastro (LGPD), e reenvio manual de mensagem que falhou." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
